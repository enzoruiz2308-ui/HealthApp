<?xml version="1.0" encoding="utf-8"?>
<!--
    PERSONA A - Parte del layout
    Incluye: header (foto de perfil + campana), tarjeta "Welcome", fila de servicios
    Este bloque va DENTRO del ConstraintLayout raíz de activity_main.xml
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    tools:context=".MainActivity">

    <!-- ============ HEADER ============ -->

    <!-- Foto de perfil (círculo) -->
    <ImageView
        android:id="@+id/ivProfile"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/profile_photo"
        android:scaleType="centerCrop"
        android:background="@drawable/bg_circle"
        android:clipToOutline="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Icono de campana (notificaciones) -->

    <!-- ============ TARJETA "WELCOME" ============ -->

    <ImageView
        android:id="@+id/ivBell"
        android:layout_width="44dp"
        android:layout_height="34dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/bg_circle_light"
        android:padding="4dp"
        android:src="@drawable/ic_bell"
        app:layout_constraintBottom_toBottomOf="@id/ivProfile"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/ivProfile"
        app:layout_constraintVertical_bias="1.0" />

    <androidx.cardview.widget.CardView
        android:id="@+id/cardWelcome"
        android:layout_width="0dp"
        android:layout_height="190dp"
        android:layout_marginTop="20dp"
        app:cardCornerRadius="20dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="@color/welcome_pink"
        app:layout_constraintTop_toBottomOf="@id/ivProfile"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- Texto de bienvenida -->
            <TextView
                android:id="@+id/tvWelcomeLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginStart="16dp"
                android:text="Welcome!"
                android:textSize="16sp"
                android:textColor="@color/white_70"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <TextView
                android:id="@+id/tvUserName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Rajesh"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@color/white_70"
                app:layout_constraintTop_toBottomOf="@id/tvWelcomeLabel"
                app:layout_constraintStart_toStartOf="@id/tvWelcomeLabel" />

            <TextView
                android:id="@+id/tvSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="How is it going today?"
                android:textSize="13sp"
                android:textColor="@color/white_70"
                android:layout_marginTop="2dp"
                app:layout_constraintTop_toBottomOf="@id/tvUserName"
                app:layout_constraintStart_toStartOf="@id/tvUserName" />

            <!-- Botón Urgent Care -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnUrgentCare"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Urgent Care"
                android:textAllCaps="false"
                android:layout_marginBottom="16dp"
                android:layout_marginStart="16dp"
                app:icon="@drawable/ic_ambulance"
                app:backgroundTint="@color/orange"
                app:cornerRadius="20dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <!-- Foto del doctor -->
            <ImageView
                android:id="@+id/ivDoctor"
                android:layout_width="197dp"
                android:layout_height="187dp"
                android:layout_marginEnd="4dp"
                android:scaleType="centerCrop"
                android:src="@drawable/doctor_photo"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0.538" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>

    <!-- ============ FILA DE SERVICIOS ============ -->

    <TextView
        android:id="@+id/tvServicesTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Our Services"
        android:textStyle="bold"
        android:textSize="16sp"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@id/cardWelcome"
        app:layout_constraintStart_toStartOf="parent" />

    <LinearLayout
        android:id="@+id/rowServices"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="3"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/tvServicesTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Servicio 1: Consultation -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <ImageView
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:padding="14dp"
                android:src="@drawable/ic_consultation"
                android:background="@drawable/bg_circle_outline" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Consultation"
                android:textSize="12sp"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <!-- Servicio 2: Medicines -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <ImageView
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:padding="14dp"
                android:src="@drawable/ic_medicines"
                android:background="@drawable/bg_circle_outline" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Medicines"
                android:textSize="12sp"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <!-- Servicio 3: Ambulance -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <ImageView
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:padding="14dp"
                android:src="@drawable/ic_ambulance_outline"
                android:background="@drawable/bg_circle_outline" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ambulance"
                android:textSize="12sp"
                android:layout_marginTop="8dp" />
        </LinearLayout>

    </LinearLayout>

    <!-- ============ TÍTULO "APPOINTMENT" + "SEE ALL" ============ -->

    <TextView
        android:id="@+id/tvAppointment"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Appointment"
        android:textStyle="bold"
        android:textSize="16sp"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@id/rowServices"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/tvSeeAll"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="See All"
        android:textColor="#2196F3"
        app:layout_constraintTop_toTopOf="@id/tvAppointment"
        app:layout_constraintBottom_toBottomOf="@id/tvAppointment"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ============ TARJETA DE LA CITA ============ -->

    <androidx.cardview.widget.CardView
        android:id="@+id/cardAppointment"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="2dp"
        app:cardBackgroundColor="#FFFFFF"
        app:layout_constraintTop_toBottomOf="@id/tvAppointment"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">

            <ImageView
                android:id="@+id/ivClock"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_clock"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <TextView
                android:id="@+id/tvAppointmentDateLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Appointment date"
                android:textSize="12sp"
                android:textColor="#888888"
                android:layout_marginStart="6dp"
                app:layout_constraintTop_toTopOf="@id/ivClock"
                app:layout_constraintBottom_toBottomOf="@id/ivClock"
                app:layout_constraintStart_toEndOf="@id/ivClock" />

            <ImageView
                android:id="@+id/ivMoreOptions"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_more_vertical"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <TextView
                android:id="@+id/tvAppointmentDateTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Wed Nov 20 • 8:00 - 8:30 AM"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginTop="6dp"
                app:layout_constraintTop_toBottomOf="@id/ivClock"
                app:layout_constraintStart_toStartOf="@id/ivClock" />

            <View
                android:id="@+id/divider"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#EEEEEE"
                android:layout_marginTop="12dp"
                app:layout_constraintTop_toBottomOf="@id/tvAppointmentDateTime"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <androidx.cardview.widget.CardView
                android:id="@+id/cardDoctorPhoto"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginTop="12dp"
                app:cardCornerRadius="22dp"
                app:layout_constraintTop_toBottomOf="@id/divider"
                app:layout_constraintStart_toStartOf="parent">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/doctor_photo"
                    android:scaleType="centerCrop" />
            </androidx.cardview.widget.CardView>

            <View
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:background="@drawable/bg_online_dot"
                app:layout_constraintBottom_toBottomOf="@id/cardDoctorPhoto"
                app:layout_constraintEnd_toEndOf="@id/cardDoctorPhoto" />

            <TextView
                android:id="@+id/tvDoctorName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Dr. Prem Tiwari"
                android:textStyle="bold"
                android:textSize="14sp"
                android:layout_marginStart="12dp"
                app:layout_constraintTop_toTopOf="@id/cardDoctorPhoto"
                app:layout_constraintStart_toEndOf="@id/cardDoctorPhoto" />

            <TextView
                android:id="@+id/tvDoctorSpecialty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Orthopedic"
                android:textSize="12sp"
                android:textColor="#888888"
                app:layout_constraintTop_toBottomOf="@id/tvDoctorName"
                app:layout_constraintStart_toStartOf="@id/tvDoctorName" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>

    <!-- ============ BARRA DE NAVEGACIÓN INFERIOR ============ -->

    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:orientation="horizontal"
        android:weightSum="5"
        android:background="#FFFFFF"
        android:gravity="center_vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="28dp"
            android:layout_weight="1"
            android:src="@drawable/ic_home"
            android:scaleType="centerInside" />

        <ImageView
            android:id="@+id/navDocument"
            android:layout_width="0dp"
            android:layout_height="28dp"
            android:layout_weight="1"
            android:src="@drawable/ic_document"
            android:scaleType="centerInside" />

        <ImageView
            android:id="@+id/navAdd"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:src="@drawable/ic_plus"
            android:scaleType="centerInside"
            android:background="@drawable/bg_circle_selected"
            android:padding="12dp" />

        <ImageView
            android:id="@+id/navChat"
            android:layout_width="0dp"
            android:layout_height="28dp"
            android:layout_weight="1"
            android:src="@drawable/ic_chat"
            android:scaleType="centerInside" />

        <ImageView
            android:id="@+id/navProfile"
            android:layout_width="0dp"
            android:layout_height="28dp"
            android:layout_weight="1"
            android:src="@drawable/ic_profile"
            android:scaleType="centerInside" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>